# Copy to .env and fill in. .env is gitignored — never commit the token.

# Fine-grained PAT with Contents: Read and write on the packs repo. Required.
GH_TOKEN=github_pat_xxx

# Where the rolling release lives. Packs currently share the app repo; point
# this at a dedicated packs repo if you split them out later.
REPO=windowsaft/easytrack
RELEASE_TAG=off-latest

# Space-separated regions to build; each becomes a pack in the one manifest.
# 'world' is the entire database (no country filter) — large and RAM-hungry
# (see NODE_HEAP_MB). Drop it here if you only ship the German-speaking market.
REGIONS=de dach world

# 03:00 on the 1st of Jan/Apr/Jul/Oct. Standard 5-field cron.
CRON_SCHEDULE=0 3 1 1,4,7,10 *

# Re-download the dump only when the cached copy is older than this. ~a quarter.
MAX_DUMP_AGE_DAYS=80

# Node heap ceiling for the build. The world region holds ~all valid products
# in memory at once; raise this (and give the host RAM) if world OOMs.
NODE_HEAP_MB=6144

# Set true for one `up` to build immediately (first publish / testing).
RUN_ON_START=false
